rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        request.auth.token.get('platformAdmin', false) == true ||
        request.auth.token.get('email', '') == 'juan.l.espeche@gmail.com' ||
        request.auth.token.get('email', '') == 'leivalihue@gmail.com' ||
        request.auth.token.get('email', '') == 'vertex.tech.dev@gmail.com'
      );
    }

    function isTenantAdmin(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        // Custom claim check (fast path — set by cloud function after provisioning)
        (request.auth.token.get('admin', false) == true && request.auth.token.get('tenantId', '') == tenantId) ||
        // Root-level composite key fallback (covers latency between admin_roles creation and claim propagation)
        (request.auth.token.get('email', '') != '' &&
         exists(/databases/$(database)/documents/admin_roles/$(tenantId)_$(request.auth.token.email)) &&
         (get(/databases/$(database)/documents/admin_roles/$(tenantId)_$(request.auth.token.email)).data.role == 'owner' ||
          get(/databases/$(database)/documents/admin_roles/$(tenantId)_$(request.auth.token.email)).data.role == 'admin'))
      );
    }


    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /tenants/{tenantId} {

      match /products/{productId} {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);

        match /{allChildren=**} {
          allow read: if true;
          allow write: if isTenantAdmin(tenantId);
        }
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /siteContent/{docId} {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /footerContent/{docId} {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /aboutUs/{docId} {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /pages/{docId} {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /configuracion/{docId} {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /settings/{docId} {
        allow read, write: if isTenantAdmin(tenantId);
      }

      match /attributes/{docId} {
        allow read: if true;
        allow write: if isTenantAdmin(tenantId);
      }

      match /users/{userId} {
        allow read: if isOwner(userId) || isTenantAdmin(tenantId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isTenantAdmin(tenantId);
        allow delete: if isTenantAdmin(tenantId);
      }

      match /clients/{clientId} {
        allow read: if isTenantAdmin(tenantId);
        allow write: if false;
      }

      match /orders/{orderId} {
        // Public create/get for guest checkout flow
        // Users return from Mercado Pago redirect and read their order by ID without auth
        allow get: if true;
        allow create: if true;
        allow list, update, delete: if isTenantAdmin(tenantId);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated()
          && (resource.data.userId == request.auth.uid || isTenantAdmin(tenantId));
      }

      match /mail/{docId} {
        allow read, write: if isTenantAdmin(tenantId);
      }
    }

    // admin_roles is at the root level with composite key {tenantId}_{email}.
    // The onRoleChange trigger in functions/role.functions.ts reads this collection
    // and sets custom auth claims. Written exclusively by the platform via Admin SDK.
    match /admin_roles/{compositeId} {
      allow read: if isAuthenticated()
        && request.auth.token.get('admin', false) == true
        && compositeId.matches(request.auth.token.get('tenantId', '') + '_.*');
      allow write: if false;
    }

    // Allow public read on legacy root documents to support storefront fallbacks on newly provisioned stores
    match /configuracion/footer {
      allow read: if true;
    }
    match /pages/aboutUs {
      allow read: if true;
    }

    // Default fallback: any unmatched path is platform-admin-only
    match /{document=**} {
      allow read, write: if false;
    }


  }
}

