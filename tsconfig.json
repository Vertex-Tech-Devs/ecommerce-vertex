{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "importHelpers": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "baseUrl": "./",
    "types": [
      "jasmine",
      "node"
    ],
    "paths": {
      "@core/*": [
        "src/app/core/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@domains/*": [
        "src/app/domains/*"
      ],
      "@features/*": [
        "src/app/features/*"
      ],
      "@environments/*": [
        "src/environments/*"
      ]
    },
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "exclude": [
    "node_modules",
    "tmp",
    "dist",
    "functions",
    "cypress",
    "**/*.cy.ts",
    "cypress.config.ts" // <-- EXCLUIMOS TAMBIÉN LA CONFIG DE CYPRESS
  ]
}