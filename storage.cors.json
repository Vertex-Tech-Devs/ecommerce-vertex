[
  {
    "origin": [
      "https://*.web.app",
      "https://*.firebaseapp.com",
      "http://localhost:4200",
      "http://localhost:4000",
      "http://localhost"
    ],
    "method": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "maxAgeSeconds": 3600,
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "Content-Length",
      "x-firebase-storage-version",
      "x-goog-resumable"
    ]
  }
]
