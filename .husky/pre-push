#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$BRANCH" = "main" ]; then
  echo ""
  echo "PRODUCTION BRANCH PROTECTED"
  echo "Cannot push directly to main"
  echo "Use GitHub PR to deploy"
  echo ""
  exit 1
fi

if [ "$BRANCH" = "develop" ]; then
  echo "Auto-fixing code..."
  npm run fix > /dev/null 2>&1
  echo "Validating..."
  npm run push
  exit $?
fi

npm run push
exit $?
