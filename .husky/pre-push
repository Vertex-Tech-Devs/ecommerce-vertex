BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$BRANCH" = "main" ]; then
  echo ""
  echo "PRODUCTION BRANCH PROTECTED"
  echo "Cannot push directly to main"
  echo "Use GitHub PR to deploy"
  echo ""
  exit 1
fi

if [ "$BRANCH" = "develop" ]; then
  echo "Validating..."
  npm run lint > /dev/null 2>&1
  if [ $? -ne 0 ]; then
    echo "ESLint validation failed. Please fix linting errors."
    exit 1
  fi
  exit 0
fi

npm run lint > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "ESLint validation failed. Please fix linting errors."
  exit 1
fi
exit 0
