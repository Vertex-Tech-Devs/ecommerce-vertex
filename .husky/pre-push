#!/bin/sh
set -e

BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "develop" ]; then
  echo ""
  echo "✖ Direct push to $BRANCH is not allowed."
  echo "  Open a PR from a feature branch."
  echo ""
  exit 1
fi

echo ""
echo "Running strict pre-push quality gates..."
echo ""

npm run lint
npm run typecheck
npm run test:ci
npm run build
cd functions
npm run test:coverage
cd ..
npm run test:integration -- --workers=1

echo ""
echo "✔ Baseline quality gates passed locally."
echo "  Full Cypress E2E remains mandatory in CI Quality Gate."
echo ""
