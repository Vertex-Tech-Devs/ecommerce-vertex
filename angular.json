{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ecommerce-vertex": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/ecommerce-vertex",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "firebase-config.json",
                "input": "src",
                "output": "/"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/bootstrap-icons/font/bootstrap-icons.css",
              "node_modules/quill/dist/quill.snow.css",
              "src/styles.scss"
            ],
            "scripts": ["node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles", "node_modules", "../node_modules"]
            },
            "allowedCommonJsDependencies": ["sweetalert2", "quill"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "4mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kb",
                  "maximumError": "24kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "baseHref": "/"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none"
            },
            "dev-template": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev-template.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ecommerce-vertex:build:production"
            },
            "development": {
              "buildTarget": "ecommerce-vertex:build:development"
            },
            "dev-template": {
              "buildTarget": "ecommerce-vertex:build:dev-template"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              }
            ],
            "scripts": [],
            "karmaConfig": "karma.conf.js",
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles", "node_modules", "../node_modules"]
            },
            "codeCoverageExclude": [
              "src/environments/**",
              "src/app/core/services/seed-data.service.ts",
              "src/app/core/services/seed-products.service.ts",
              "src/app/core/services/seed-orders.service.ts",
              "src/app/core/services/seed-content.service.ts",
              "src/app/core/services/firestore.service.ts",
              "src/app/core/services/auth.service.ts",
              "src/app/core/services/payment.service.ts",
              "src/app/core/services/about-us.service.ts",
              "src/app/core/services/attribute.service.ts",
              "src/app/core/services/category.service.ts",
              "src/app/core/services/client.service.ts",
              "src/app/core/services/email-settings.service.ts",
              "src/app/core/services/footer.service.ts",
              "src/app/core/services/home-content.service.ts",
              "src/app/core/services/order.service.ts",
              "src/app/core/services/product.service.ts",
              "src/app/core/services/storage.service.ts",
              "src/app/core/services/store-config.service.ts",
              "src/app/core/components/deploying-state/**",
              "src/app/core/handlers/**",
              "src/app/features/admin/components/store-config-management/**",
              "src/app/features/admin/components/store-config/**",
              "src/app/features/admin/components/header-announcements/**",
              "src/app/features/admin/components/products/product-create/**",
              "src/app/features/admin/components/home-management/hero-image-uploader.service.ts",
              "src/app/core/services/image-validation.service.ts",
              "src/app/features/shop/components/catalog/**",
              "src/app/features/shop/components/checkout/**",
              "src/app/features/shop/components/product-detail/**",
              "src/app/features/shop/components/order-confirmation/**",
              "src/app/features/admin/components/home-management/**",
              "src/app/features/admin/components/about-us-management/**",
              "src/app/features/admin/components/email-management/**",
              "src/app/features/admin/components/delivery/**",
              "src/app/features/admin/components/branches-management/**",
              "src/app/features/admin/components/header-management/**",
              "src/app/features/admin/components/products/product-detail/**",
              "src/app/features/admin/components/products/products-list/**",
              "src/app/features/admin/components/login/**",
              "src/app/features/admin/components/attributes/**",
              "src/app/features/shop/layout/shop/**",
              "src/app/features/admin/admin.ts",
              "**/*.spec.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  }
}
